ARG BASE_REGISTRY=ghcr.io/tom-pit
FROM ${BASE_REGISTRY}/tompit-base-release:stable AS base

FROM ${BASE_REGISTRY}/tompit-sdk:stable AS build

WORKDIR /src

COPY . .

WORKDIR /dxpackages

COPY ./DXPackageCache/ /dxpackages/

WORKDIR /src

RUN mkdir -p /plugins

RUN dotnet build "./Build/DevExpress/DevExpress.csproj" -c Release -o /releaseDev /p:UseAppHost=false
RUN dotnet build "./Build/Build.sln" --no-incremental --force -c Release /p:UseAppHost=false
RUN dotnet build "./TomPIT.Connected/TomPIT.Connected.csproj" --no-incremental --force -c Release -o /release /p:UseAppHost=false

FROM base AS final
LABEL author="Gregor Šoln <gregor.soln@tompit.com>"
LABEL maintainer="Matija Koželj <matija.kozelj@tompit.com>"
LABEL description="TomPIT, open source digital experience platform"
LABEL version="3.1"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.authors="Gregor Šoln <gregor.soln@tompit.com>"
LABEL org.opencontainers.image.url="tompitdev/connected"
LABEL org.opencontainers.image.documentation="https://github.com/Tom-PIT/Connected#readme"
LABEL org.opencontainers.image.vendor="TomPIT d.o.o."
LABEL org.opencontainers.image.title="TomPIT"
LABEL org.opencontainers.image.description="TomPIT, open source digital experience platform"

ENV ASPNETCORE_URLS="http://0.0.0.0:44003"
ENV instanceName="Default Instance"
ENV features="Application, Worker, Cdn, Rest, Search, BigData, Sys, IoT, Development, Management"
ENV platfrom="OnPrem"
ENV stage="QualityAssurance"
ENV optimization="Release"
ENV resourceGroups__0="Default"
ENV database="TomPIT.SysDb.Sql.SqlProxy, TomPIT.SysDb.Sql"
ENV authentication__jwToken__validIssuer="tompit.com"
ENV authentication__jwToken__validAudience="tompit.com"
ENV authentication__jwToken__issuerSigningKey="shouldBeReplacedWithExteriorVariablesToIncreaseSecurity"
ENV debugTarget__url=
ENV debugTarget__token=
ENV sys__name="Local"
ENV sys__url="http://localhost:44003"
ENV sys__token=
ENV storage__databases__defaultConnectionString=
ENV deployment__userToken=
ENV instanceEndpoints__0__url="http://localhost:44003"
ENV instanceEndpoints__0__name="All"
ENV instanceEndpoints__0__features="${features}"
ENV settings__0__name="ConnectionString"
ENV settings__0__namespace="Common"
ENV settings__0__value="${storage__databases_defaultConnectionString}"
ENV settings__1__name="Cors Enabled"
ENV settings__1__value="false"
ENV settings__2__name="SearchPath"
ENV settings__2__value="/appsearch"
ENV sqlScriptPaths__create="/installer/package/Create.sql"
ENV sqlScriptPaths__update="/installer/package/Update.json"
ENV diagnostics__dumpEnabled="false"
ENV storageProviders__0="TomPIT.StorageProvider.Sql.SqlStorageProvider, TomPIT.StorageProvider.Sql"
ENV dataProviders__0="TomPIT.DataProviders.Sql.SqlDataProvider, TomPIT.DataProviders.Sql"
ENV dataProviders__1="TomPIT.DataProviders.BigData.BigDataProvider, TomPIT.DataProviders.BigData"
ENV designers__0="TomPIT.MicroServices.Design.MicroServicesTemplate, TomPIT.MicroServices.Design"
ENV designers__1="TomPIT.MicroServices.IoT.Design.IoTTemplate, TomPIT.MicroServices.IoT.Design"
ENV designers__2="TomPIT.MicroServices.BigData.Design.BigDataTemplate, TomPIT.MicroServices.BigData.Design"
ENV designers__3="TomPIT.MicroServices.Reporting.Design.ReportTemplate, TomPIT.MicroServices.Reporting.Design"
ENV plugins__location="/plugins"
ENV plugins__shadoCopy="false"
ENV plugins_items__0="TomPIT.MicroServices.Configuration.Runtime.Plugin, TomPIT.MicroServices"
ENV plugins_items__1="TomPIT.MicroServices.IoT.Configuration.Runtime.Plugin, TomPIT.MicroServices.IoT"
ENV plugins_items__2="TomPIT.MicroServices.Reporting.Runtime.Configuration.Plugin, TomPIT.MicroServices.Reporting"
ENV microServicesFolder="/microServices"
ENV Logging__LogLevel__Default="Warning"
ENV sourceFiles__folder="/microServices/sources"
ENV routing__baseUrl="http://localhost:44003"

ENV SERVICE_NAME="tompit"
ENV GID=1900
ENV UID2=1900
RUN addgroup --gid $GID --system $SERVICE_NAME && \
    adduser --system --shell /bin/false --disabled-password --ingroup $SERVICE_NAME --uid $UID2 $SERVICE_NAME

RUN mkdir -p /applogs \
    && mkdir -p /appsearch \
    && mkdir -p /microServices \
    && mkdir -p /microServices/sources \
    && mkdir -p /microServices/Precompiled \
    && mkdir -p /app \
    && mkdir -p /plugins

WORKDIR /app
RUN mkdir -p /app/appservice/Plugins
COPY --from=build /release /app/appservice
COPY --from=build /src/plugins /plugins
COPY --from=build /releaseDev /plugins
COPY --from=build /src/setup /app
COPY --from=build /src/installer /installer
COPY --from=build /release/runtimes/linux-x64/native /plugins
RUN chmod -R 755 /applogs && \
    chmod -R 775 /appsearch && \
    chmod -R 775 /microServices && \
    chmod -R 755 /app && \
    chmod -R 755 /plugins && \
    chmod -R 755 /installer && \
    chown -R $UID2:$GID /applogs && \
    chown -R $UID2:$GID /appsearch && \
    chown -R $UID2:$GID /app && \
    chown -R $UID2:$GID /plugins && \
    chown -R $UID2:$GID /microServices && \
    chown -R $UID2:$GID /installer

RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
USER $UID2:$GID
ENTRYPOINT ["/app/run.sh"]

#RUN apt-get install -y wget \
#    wget http://ftp.br.debian.org/debian/pool/contrib/m/msttcorefonts/ttf-mscorefonts-installer_3.8.1_all.deb && \
#    apt --fix-broken install -y ./ttf-mscorefonts-installer_3.8.1_all.deb && \
#    rm ttf-mscorefonts-installer_3.8.1_all.deb && \
#    fc-cache -f -v

FROM mcr.microsoft.com/dotnet/sdk:7.0 AS build

WORKDIR /src

COPY . .

WORKDIR /dxpackages

COPY ./DXPackageCache/ /dxpackages/

WORKDIR /src

RUN apt-get update && apt-get install npm -y

RUN mkdir -p /plugins

#RUN dotnet clean "./Build/Build.sln" 
#RUN dotnet clean "./TomPIT.Connected/TomPIT.Connected.csproj"

RUN dotnet build "./Build/DevExpress/DevExpress.csproj" -c Release -o /releaseDev /p:UseAppHost=false
RUN dotnet build "./Build/Build.sln" --no-incremental --force -c Release /p:UseAppHost=false
RUN dotnet build "./TomPIT.Connected/TomPIT.Connected.csproj" --no-incremental --force -c Release -o /release /p:UseAppHost=false

FROM base as final
LABEL author="Gregor Šoln <gregor.soln@tompit.com>"
LABEL maintainer="Matija Koželj <matija.kozelj@tompit.com>"
LABEL description="TomPIT, open source digital experience platform"
LABEL version="3.1"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.authors="Gregor Šoln <gregor.soln@tompit.com>"
LABEL org.opencontainers.image.url="tompitdev/connected"
LABEL org.opencontainers.image.documentation="https://github.com/Tom-PIT/Connected#readme"
LABEL org.opencontainers.image.vendor="TomPIT d.o.o."
LABEL org.opencontainers.image.title="TomPIT"
LABEL org.opencontainers.image.description="TomPIT, open source digital experience platform"

ENV ASPNETCORE_URLS="http://0.0.0.0:44003"
ENV instanceName="Default Instance"
ENV features="Application, Worker, Cdn, Rest, Search, BigData, Sys, IoT, Development, Management"
ENV platfrom="OnPrem"
ENV stage="QualityAssurance"
ENV optimization="Release"
ENV resourceGroups__0="Default"
ENV database="TomPIT.SysDb.Sql.SqlProxy, TomPIT.SysDb.Sql"
ENV authentication__jwToken__validIssuer="tompit.com"
ENV authentication__jwToken__validAudience="tompit.com"
ENV authentication__jwToken__issuerSigningKey="shouldBeReplacedWithExteriorVariablesToIncreaseSecurity"
ENV debugTarget__url=
ENV debugTarget__token=
ENV sys__name="Local"
ENV sys__url="http://localhost:44003"
ENV sys__token=
ENV storage__databases__defaultConnectionString=
ENV deployment__userToken=
ENV instanceEndpoints__0__url="http://localhost:44003"
ENV instanceEndpoints__0__name="All"
ENV instanceEndpoints__0__features="${features}"
ENV settings__0__name="ConnectionString"
ENV settings__0__namespace="Common"
ENV settings__0__value="${storage__databases_defaultConnectionString}"
ENV settings__1__name="Cors Enabled"
ENV settings__1__value="false"
ENV settings__2__name="SearchPath"
ENV settings__2__value="/appsearch"
ENV sqlScriptPaths__create="/installer/package/Create.sql"
ENV sqlScriptPaths__update="/installer/package/Update.json"
ENV diagnostics__dumpEnabled="false"
ENV storageProviders__0="TomPIT.StorageProvider.Sql.SqlStorageProvider, TomPIT.StorageProvider.Sql"
ENV dataProviders__0="TomPIT.DataProviders.Sql.SqlDataProvider, TomPIT.DataProviders.Sql"
ENV dataProviders__1="TomPIT.DataProviders.BigData.BigDataProvider, TomPIT.DataProviders.BigData"
ENV designers__0="TomPIT.MicroServices.Design.MicroServicesTemplate, TomPIT.MicroServices.Design"
ENV designers__1="TomPIT.MicroServices.IoT.Design.IoTTemplate, TomPIT.MicroServices.IoT.Design"
ENV designers__2="TomPIT.MicroServices.BigData.Design.BigDataTemplate, TomPIT.MicroServices.BigData.Design"
ENV designers__3="TomPIT.MicroServices.Reporting.Design.ReportTemplate, TomPIT.MicroServices.Reporting.Design"
ENV plugins__location="/plugins"
ENV plugins__shadoCopy="false"
ENV plugins_items__0="TomPIT.MicroServices.Configuration.Runtime.Plugin, TomPIT.MicroServices"
ENV plugins_items__1="TomPIT.MicroServices.IoT.Configuration.Runtime.Plugin, TomPIT.MicroServices.IoT"
ENV plugins_items__2="TomPIT.MicroServices.Reporting.Runtime.Configuration.Plugin, TomPIT.MicroServices.Reporting"
ENV microServicesFolder="/microServices"
ENV Logging__LogLevel__Default="Warning"
ENV sourceFiles__folder="/microServices/sources"
ENV routing__baseUrl="http://localhost:44003"

# user management 
# `container-admin' created on shared volume to use as runAsUser in container to be able to access /appsearch
# `container-admin' (GID 1900)
# `container-admin' (UID 1900)
ENV SERVICE_NAME="tompit"
ENV GID=1900
ENV UID2=1900
RUN addgroup --gid $GID --system $SERVICE_NAME && \
    adduser --system --shell /bin/false --disabled-password --ingroup $SERVICE_NAME --uid $UID2 $SERVICE_NAME
RUN apt-get update && apt-get upgrade -y
RUN mkdir -p /applogs \
    && mkdir -p /appsearch \
    && mkdir -p /microServices \
    && mkdir -p /microServices/sources \
    && mkdir -p /microServices/Precompiled \
    && mkdir -p /app \
    && mkdir -p /plugins 

WORKDIR /app
RUN mkdir -p /app/appservice/Plugins
COPY --from=build /release /app/appservice
COPY --from=build /src/plugins /plugins
COPY --from=build /releaseDev /plugins
COPY --from=build /src/setup /app
COPY --from=build /src/installer /installer
COPY --from=build /release/runtimes/linux-x64/native /plugins
RUN chmod -R 755 /applogs && \
    chmod -R 775 /appsearch && \
    chmod -R 775 /microServices && \
    chmod -R 755 /app && \
    chmod -R 755 /plugins && \
    chmod -R 755 /installer && \
    chown -R $UID2:$GID /applogs && \
    chown -R $UID2:$GID /appsearch && \
    chown -R $UID2:$GID /app && \
    chown -R $UID2:$GID /plugins && \
    chown -R $UID2:$GID /microServices && \
    chown -R $UID2:$GID /installer

RUN apt-get update && apt-get upgrade -y
USER $UID2:$GID
ENTRYPOINT ["/app/run.sh"]
