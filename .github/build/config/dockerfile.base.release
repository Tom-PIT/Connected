FROM mcr.microsoft.com/dotnet/aspnet:7.0
# Runtime base for the release final stage.
# Rebuilt periodically via build-base.yml — not on every app build.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    netcat-traditional procps libc6 libicu-dev libfontconfig1 jq fontconfig wget \
    && wget -q http://ftp.de.debian.org/debian/pool/main/c/ca-certificates/ca-certificates_20250419_all.deb \
    && apt install -y ./ca-certificates_20250419_all.deb \
    && update-ca-certificates \
    && rm ca-certificates_20250419_all.deb \
    && apt-get install -y --no-install-recommends fonts-crosextra-carlito fonts-crosextra-caladea \
    && sed -i -e "s/ main[[:space:]]*\$/ main contrib non-free/" /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y ttf-mscorefonts-installer \
    && rm -rf /var/lib/apt/lists/*
